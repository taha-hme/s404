# ------------------------------------------------------------------------------
# S404 — The English League Environment Variables
# Copy this file to ".env" for local development or configure in GitHub Secrets
# and your hosting platform's environment settings for production.
# ------------------------------------------------------------------------------

# Server runtime
NODE_ENV=development
PORT=3000
TRUST_PROXY=1
LOG_REQUESTS=false

# PostgreSQL connection (standard hosts: Liara, Docker Compose, VPS, etc.)
DATABASE_URL=

# Optional SSL override for remote PostgreSQL ("require", "no-verify", or "false")
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Legacy Cloud SQL connection fallback (used only if DATABASE_URL is empty)
SQL_HOST=
SQL_PORT=5432
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Session cookie signing secret (recommended in production: 32+ random chars; auto-persisted in DB if omitted)
SESSION_SECRET=

# Initial teacher password override (optional; defaults to initial salted hash if unset)
TEACHER_PASSWORD=

# Security & domain settings
# Comma-separated frontend origins allowed for CORS/CSRF when frontend & backend are split
# Example: https://s404class.org,https://www.s404class.org
ALLOWED_ORIGINS=

# Cookie SameSite policy: "auto" (default), "lax" (recommended for same-origin custom domain), "strict", or "none"
COOKIE_SAMESITE=auto

# Set to "true" on standalone custom domains to disallow embedding in external iframes
FRAME_ANCESTORS_SELF=false

# Frontend build-time API base URL (leave blank when Express serves the built frontend on the same domain)
VITE_API_BASE_URL=
